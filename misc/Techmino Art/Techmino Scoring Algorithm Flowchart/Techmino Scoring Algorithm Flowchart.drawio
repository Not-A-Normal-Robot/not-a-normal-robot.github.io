        <mxCell id="q72EYVab2g4kFUrSe0m0-187" value="&lt;div&gt;The drop speed is as shown in the display to the bottom right of your playfield.&lt;/div&gt;&lt;div&gt;It is measured in pieces per minute. Divide it by 60 to get your pieces per second.&lt;br&gt;&lt;/div&gt;" style="text;html=1;align=right;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" vertex="1" parent="q72EYVab2g4kFUrSe0m0-181">
